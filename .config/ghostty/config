font-family = "BIZ UDGothic Bold"
adjust-cell-height = 20%
theme = Dracula

focus-follows-mouse = false

cursor-opacity = 1.0
window-save-state = always
font-thicken
macos-titlebar-style = tabs

# tmux pane navigation
keybind = super+shift+j=text:\x02;
keybind = super+shift+k=text:\x02o

# claude code
keybind = shift+enter=text:\x1b\r

# tmux split window
keybind = super+n=text:\x02%
keybind = super+shift+n=text:\x02"

# vim-visual-multi (multi cursor)
keybind = super+d=text:\x1b[100;9u
