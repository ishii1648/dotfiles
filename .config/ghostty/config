font-family = "BIZ UDGothic Bold"
adjust-cell-height = 20%
theme = Dracula

# フォーカス表示の改善
unfocused-split-opacity = 0.6
unfocused-split-fill = #1a1a2e
focus-follows-mouse = false

# 区切り線の色（Dracula Purple - 落ち着いた紫）
split-divider-color = #bd93f9

cursor-opacity = 1.0
window-save-state = always
font-thicken
macos-titlebar-style = tabs

keybind = super+shift+j=goto_split:previous
keybind = super+shift+k=goto_split:next

# claude code
keybind = shift+enter=text:\x1b\r

# 分割機能をCmd+Nに移動（デフォルトのCmd+Dから変更）
keybind = super+n=new_split:right
keybind = super+shift+n=new_split:down

# vim-visual-multi (multi cursor)
keybind = super+d=text:\x1b[100;9u
