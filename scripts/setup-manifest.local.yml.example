# scripts/setup-manifest.local.yml
# 環境依存の設定をここに記述する（gitignore 済み）
components:
  git:
    setup_args:
      user_name: "Your Name"
      user_email: "your_email@example.com"
      ghq_root: ~/src
      auth_key: ~/.ssh/id_ed25519_github
      sign_key: ~/.ssh/id_ed25519_github_sign
  # ADR-095: board の起点のリポジトリ（Issue を起票し、worktree を切るリポジトリ）
  board:
    setup_args:
      repo: owner/name
      repo_path: ~/ghq/github.com/owner/name
  # ADR-096: direnv が自動で allow するディレクトリ（":" 区切り）
  direnv:
    setup_args:
      whitelist_prefix: ~/ghq/github.com/owner/name:~/orca/workspaces
