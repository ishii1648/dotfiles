command = ~/.local/bin/herdr
font-family = "BIZ UDGothic Bold"
adjust-cell-height = 20%
theme = Dracula

# 背景を暗くして壁紙透過時の視認性を確保
background = #181a2a
background-opacity = 0.9
minimum-contrast = 1.2
cursor-opacity = 1.0
window-save-state = never
font-thicken
macos-titlebar-style = transparent
macos-option-as-alt = true
clipboard-write = allow
clipboard-read = allow

keybind = super+r=reload_config
keybind = super+shift+r=text:\x00r

# claude code
keybind = shift+enter=text:\x1b\r

# vim-visual-multi (multi cursor)
keybind = super+d=text:\x1b[100;9u

# Neovim: Cmd+Shift+F → live_grep, Cmd+P → find_files (tmux経由はAltにリマップ)
keybind = super+shift+f=text:\x1bF
keybind = super+p=text:\x1bp

# --- tmux 操作 (prefix = Ctrl+Space = \x00) ---

# ペイン分割
keybind = super+n=text:\x00n
keybind = super+shift+n=text:\x00v

# ペイン移動
keybind = super+shift+h=text:\x00h
keybind = super+shift+j=text:\x00j
keybind = super+shift+k=text:\x00k
keybind = super+shift+l=text:\x00l

# コピーモード (prefix + i)
keybind = super+i=text:\x00i

# URL一覧表示 (prefix + u → tmux-fzf-url)
keybind = super+u=text:\x00u

# ウィンドウ/セッション操作
keybind = super+t=text:\x00c
keybind = super+w=text:\x00x
keybind = super+shift+w=close_surface
# herdr: workspace_picker（prefix+s）。旧・tmux-sidebar focus-or-open（User15）から転用。
# tmux 側は prefix+s = `bind s`（fzf セッション picker `tm`）に挙動が変わる。
# tmux.conf の user-keys[15]/User15 バインドはこの変更後どのキーからも届かなくなる
# （残置は無害。Phase 3 の tmux 撤去時にまとめて掃除する）
keybind = super+s=text:\x00s
keybind = super+shift+s=text:\x00S
# herdr: goto（session navigator、prefix+g）。tmux に bind g は無いため tmux 側は影響なし
keybind = super+g=text:\x00g
keybind = super+shift+e=text:\x00e

# tmux ウィンドウ移動 (Ctrl+Tab / Ctrl+Shift+Tab → CSI u シーケンス)
keybind = ctrl+tab=text:\x1b[9;5u
keybind = ctrl+shift+tab=text:\x1b[9;6u

# ペインスクロール (herdr の page-key 横取り経由)
# 旧: tmux user-keys (\x1b[1;9A / \x1b[106;9~ 等)。herdr にはこれらのバインドが
# 存在せず、ペイン内アプリへ生シーケンスが漏れるだけだったため PageUp/PageDown へ差替。
# herdr はページキーをフォーカス中ペインの scrollback スクロールとして横取りする。
keybind = super+up=text:\x1b[5~
keybind = super+down=text:\x1b[6~
keybind = super+k=text:\x1b[5~
keybind = super+j=text:\x1b[6~

# タブ切替 (super+1~9 → herdr switch_tab = prefix+1..9)
# NOTE: 数字キーの正しい key 名は super+digit_N（super+one 等は無効な key 名で
# silent に無視される。`ghostty +list-keybinds` の出力に一切出ないことで判明）。
# ghostty には super+digit_1..8=goto_tab:N という既定バインドがあり、この上書きになる
# （ネイティブの ghostty タブ機能は使っていないため実害なし）。
# 旧: tmux user-keys (User4-12 → select-window) 経由の想定だったが、旧 super+one 等が
# そもそも無効な key 名だったため実際には一度も機能しておらず、tmux 側の喪失は無い。
keybind = super+digit_1=text:\x001
keybind = super+digit_2=text:\x002
keybind = super+digit_3=text:\x003
keybind = super+digit_4=text:\x004
keybind = super+digit_5=text:\x005
keybind = super+digit_6=text:\x006
keybind = super+digit_7=text:\x007
keybind = super+digit_8=text:\x008
keybind = super+digit_9=text:\x009

# Claude セッションナビゲーション (ADR-058) の super+c → tmux cursor mode は削除。
# herdr には対応バインドが無く、Ghostty 既定の super+c=copy_to_clipboard を潰したうえで
# ペインへ \x1b[99;9~ が漏れるだけだった。COPY モード (super+i) の y/enter でコピーする。

# ローカル設定（オプション、git管理外）
config-file = ?local.conf
