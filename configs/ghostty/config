command = ~/.local/bin/herdr
font-family = "BIZ UDGothic Bold"
adjust-cell-height = 20%
# macOS の外観設定（ライト/ダーク）に追随する
theme = light:Catppuccin Latte,dark:Dracula

# background は明示指定しない（指定するとライト時も暗いまま残る）
# 透過は切る。壁紙の明暗がそのままコントラストのムラになるうえ、minimum-contrast は
# 設定上の背景色に対して比を計算するため、透過分だけ見た目とずれる
background-opacity = 1.0
# Catppuccin Latte は 17 色中 9 色が背景 #eff1f5 に対してコントラスト比 3.0 未満で、
# dim 表現（br-white 1.61 / br-yellow 1.91）が背景に沈む。薄い前景色を持ち上げる。
# 1.2 は実質無効な値だった
minimum-contrast = 3.0
cursor-opacity = 1.0
window-save-state = never
font-thicken
macos-titlebar-style = transparent
macos-option-as-alt = true
clipboard-write = allow
clipboard-read = allow

keybind = super+r=reload_config
keybind = super+shift+r=text:\x00r

# claude code
keybind = shift+enter=text:\x1b\r

# space（workspace）/ タブ削除
# Ctrl+D は意図的にバインドしない。ペイン内アプリへ 0x04(EOF) をそのまま渡し、
# fish / less / REPL / Claude Code の Ctrl+D 終了を使えるようにするため
# （旧: herdr close_pane = prefix+x にバインドしていたが解除）。
# Cmd+D = herdr close_workspace（prefix+d、リテラル小文字 d）。フォーカス中の space を閉じる。
# herdr は端末から届いたリテラル大文字を shift 付きとして解釈しない（\x00D を送ると
# prefix+shift+d ではなく prefix+d が発火する）ため、herdr 側で close_workspace を
# prefix+d に置き、detach を prefix+q へ退避してある。ghostty からは小文字だけを送る。
# 旧: close_tab（\x00X）。さらに旧: vim-visual-multi (multi cursor) 用 \x1b[100;9u。
# prefix シーケンスは herdr が消費するためペインへ届かず、Cmd+D 経由の multi cursor は
# 到達不能。Neovim 内では vm の既定キー（<C-n> 等）を直接押す運用に戻る。
keybind = super+d=text:\x00d
# Cmd+Shift+X = herdr close_tab（prefix+w、リテラル小文字 w）。Cmd+D を close_workspace に
# 譲ったための移設先。上と同じ理由で \x00X は使えない（close_pane が発火する）ので、
# herdr 側の close_tab を prefix+w に移してある。キー名 X と送出文字 w がずれるのはこのため。
keybind = super+shift+x=text:\x00w

# Neovim: Cmd+Shift+F → live_grep, Cmd+P → find_files (tmux経由はAltにリマップ)
keybind = super+shift+f=text:\x1bF
keybind = super+p=text:\x1bp

# --- tmux 操作 (prefix = Ctrl+Space = \x00) ---

# ペイン分割
keybind = super+n=text:\x00n
keybind = super+shift+n=text:\x00v

# ペイン移動
keybind = super+shift+h=text:\x00h
keybind = super+shift+j=text:\x00j
keybind = super+shift+k=text:\x00k
keybind = super+shift+l=text:\x00l

# コピーモード (prefix + i)
keybind = super+i=text:\x00i

# URL一覧表示 (prefix + u → tmux-fzf-url)
keybind = super+u=text:\x00u

# ウィンドウ/セッション操作
keybind = super+t=text:\x00c
keybind = super+w=text:\x00x
keybind = super+shift+w=close_surface
# herdr: workspace_picker（prefix+s、"Select space" ピッカー）。
# 一時 close_workspace を割り当てていたが、close_workspace は Cmd+D へ移したため picker に戻した。
keybind = super+s=text:\x00s
# herdr: ghq リポジトリピッカー popup（[[keys.command]] key = "prefix+p"、ADR-077）。
# 旧 \x00S は herdr がリテラル大文字を shift 付きとして解釈しないため prefix+s と等価になり、
# workspace_picker が開いてしまっていた。close_workspace / close_tab と同様に小文字へ移す。
keybind = super+shift+s=text:\x00p
# Cmd+G は将来別のアクションに割り当てるため空けてある（ADR-080）。
# 以前は herdr の goto（session navigator、prefix+g）へ配線していたが、エージェント間の移動は
# Cmd+A のピッカー（ADR-079）と Cmd+S の workspace_picker で足りるため外した。
# 単に行を消すと ghostty 組み込みの super+g=navigate_search:next が復活してしまうので、
# ignore（ghostty が握り潰し、herdr にも渡さない）を明示する。
# herdr 側の goto = "prefix+g" は残してあり、物理 Ctrl+Space → g では従来どおり開ける。
keybind = super+g=ignore
# herdr: エージェントピッカー popup（[[keys.command]] key = "prefix+a"、ADR-079）。
# ghostty 組み込みの super+a=select_all を上書きする。herdr セッションでは
# [ui] copy_on_select = true と copy_mode（Cmd+I）があるため全選択の欠落は許容する。
keybind = super+a=text:\x00a
keybind = super+shift+e=text:\x00e

# tmux ウィンドウ移動 (Ctrl+Tab / Ctrl+Shift+Tab → CSI u シーケンス)
keybind = ctrl+tab=text:\x1b[9;5u
keybind = ctrl+shift+tab=text:\x1b[9;6u

# ペインスクロール (herdr の page-key 横取り経由)
# 旧: tmux user-keys (\x1b[1;9A / \x1b[106;9~ 等)。herdr にはこれらのバインドが
# 存在せず、ペイン内アプリへ生シーケンスが漏れるだけだったため PageUp/PageDown へ差替。
# herdr はページキーをフォーカス中ペインの scrollback スクロールとして横取りする。
keybind = super+up=text:\x1b[5~
keybind = super+down=text:\x1b[6~
keybind = super+k=text:\x1b[5~
keybind = super+j=text:\x1b[6~

# タブ切替 (super+1~9 → herdr switch_tab = prefix+1..9)
# NOTE: 数字キーの正しい key 名は super+digit_N（super+one 等は無効な key 名で
# silent に無視される。`ghostty +list-keybinds` の出力に一切出ないことで判明）。
# ghostty には super+digit_1..8=goto_tab:N という既定バインドがあり、この上書きになる
# （ネイティブの ghostty タブ機能は使っていないため実害なし）。
# 旧: tmux user-keys (User4-12 → select-window) 経由の想定だったが、旧 super+one 等が
# そもそも無効な key 名だったため実際には一度も機能しておらず、tmux 側の喪失は無い。
keybind = super+digit_1=text:\x001
keybind = super+digit_2=text:\x002
keybind = super+digit_3=text:\x003
keybind = super+digit_4=text:\x004
keybind = super+digit_5=text:\x005
keybind = super+digit_6=text:\x006
keybind = super+digit_7=text:\x007
keybind = super+digit_8=text:\x008
keybind = super+digit_9=text:\x009

# Claude セッションナビゲーション (ADR-058) の super+c → tmux cursor mode は削除。
# herdr には対応バインドが無く、Ghostty 既定の super+c=copy_to_clipboard を潰したうえで
# ペインへ \x1b[99;9~ が漏れるだけだった。COPY モード (super+i) の y/enter でコピーする。

# ローカル設定（オプション、git管理外）
config-file = ?local.conf
