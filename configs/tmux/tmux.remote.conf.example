# tmux リモート設定（SSH先マシン用）
# SSH先の ~/.tmux.local.conf にコピーして使用する
#
# リモート側では Ghostty user-keys が届かないため、
# ローカル固有のキーバインド設定は不要。
# 必要に応じてリモート環境固有のオーバーライドをここに追加する。

# セッション切替（リモートには fish/fzf/tm がないため tmux 組み込みを使用）
bind s choose-tree -s

# git コマンドの定期実行を無効化（リモートでのかくつき防止）
set -g status-right "#[fg=#6272a4]%H:%M "
