# tmux ローカル設定（マシン固有のオーバーライド）
# ~/.tmux.local.conf にコピーしてカスタマイズ
#
# 例:
# set -g status-right "#[fg=#6272a4]%H:%M "

# F12: ローカル tmux を無効化してリモート tmux にパススルー
bind -T root F12 \
  set prefix None \;\
  set key-table off \;\
  set status-style "bg=#444444" \;\
  refresh-client -S

bind -T off F12 \
  set -u prefix \;\
  set -u key-table \;\
  set -u status-style \;\
  refresh-client -S
