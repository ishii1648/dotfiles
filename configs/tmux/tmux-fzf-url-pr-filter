#!/usr/bin/env bash
# tmux-fzf-url extra filter: 現在の pane の git remote から PR URL を生成する
# Output format: colored-branch URL (URL is always the last field, uncolored)
# Usage: tmux-fzf-url-pr-filter (stdin は無視)
#
# 過去はペイン上の #NNN パターンも PR URL に変換していたが、PR が存在しない番号
# まで誤検出するため削除。statusline.js のキャッシュ → gh pr view の順で参照する。

pane_path=$(tmux display-message -p '#{pane_current_path}' 2>/dev/null)
[ -z "$pane_path" ] && exit 0

remote_url=$(git -C "$pane_path" remote get-url origin 2>/dev/null)
[ -z "$remote_url" ] && exit 0

# SSH or HTTPS remote → https://github.com/{owner}/{repo}
github_base=$(echo "$remote_url" | sed -E 's#git@github\.com:(.+)(\.git)?$#https://github.com/\1#; s#https://github\.com/(.+)(\.git)?$#https://github.com/\1#; s/\.git$//')
[ -z "$github_base" ] && exit 0

branch=$(git -C "$pane_path" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "-")
pane_cmd=$(tmux display-message -p '#{pane_current_command}' 2>/dev/null)

# statusline.js が書くキャッシュを優先（ネットワーク遅延を回避）
cache_key=$(echo -n "$pane_path" | md5)
cache_file="/tmp/gh-pr-${cache_key}"
if [ -f "$cache_file" ]; then
    pr_output=$(cat "$cache_file")
else
    pr_output=$(cd "$pane_path" && gh pr view --json number,url -q '"\(.number) \(.url)"' 2>/dev/null)
fi

[ -z "$pr_output" ] && exit 0

pr_url=$(echo "$pr_output" | cut -d' ' -f2)
if [[ "$pane_cmd" == "claude" ]]; then
    echo -e "\033[32m${branch}\033[0m \033[36m${pr_url}\033[0m"
else
    echo -e "\033[36m${pr_url}\033[0m"
fi
