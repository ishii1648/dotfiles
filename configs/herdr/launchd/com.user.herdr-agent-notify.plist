<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.herdr-agent-notify</string>
    <!-- launchd は $HOME を展開しないため bash -lc 経由にする（worktree-auto-cleanup と同型）。
         ログのリダイレクトも同じ理由でここで行う -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>mkdir -p "$HOME/.local/state/herdr" &amp;&amp; exec "$HOME/.local/bin/herdr-agent-notify" >> "$HOME/.local/state/herdr/agent-notify.log" 2>&amp;1</string>
    </array>
    <!-- KeepAlive は使わない: この macOS (Darwin 25) では launchd が KeepAlive/RunAtLoad の
         nondemand spawn を "pended (speculative/inefficient)" として無期限保留することがあり
         （実測）、kill 後の再起動が保証できない。確実に発火するタイマー spawn（2分間隔）+
         watcher 側の flock 単一インスタンスガードで常駐を維持する（agent-notify.py 冒頭コメント参照）。
         RunAtLoad はベストエフォートの即時起動として残す（保留されても次の tick で起動する）。 -->
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>120</integer>
</dict>
</plist>
