[alias]
    push-f = push --force-with-lease
    st = status -sb
    co = checkout
    br = branch -vv
    sw = switch
    aa = add -A
    cm = commit -m
    amend = commit --amend --no-edit
[commit]
    gpgsign = true
[gpg]
    format = ssh
[url "git@github.com:"]
    insteadOf = https://github.com/
