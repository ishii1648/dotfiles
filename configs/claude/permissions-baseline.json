{
  "$comment": [
    "Claude Code の permissions ベースライン定義（ADR-092）。",
    "これは配布物ではなく検査基準である。configs/claude/setup.sh は ~/.claude/settings.json を",
    "この内容で上書きせず、欠落を報告するだけにとどめる（--fix 指定時のみ追加する）。",
    "required.deny は端末の役割によらず必ず入っているべきガード。",
    "recommended.allow は入っていなくても害はなく、permission prompt が増えるだけのもの。",
    "端末固有の deny（kubectl / terraform / aws / gcloud / Artifact / claude-in-chrome 等）は",
    "ここに置かない。端末ごとの ~/.claude/settings.json で管理する。",
    "書式は Bash(cmd *) と Bash(cmd:*) が等価。setup.sh は末尾の :* を正規化して照合する。"
  ],
  "required": {
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r -f *)",
      "Bash(rm -f -r *)",
      "Bash(sudo *)",
      "Bash(chmod *)",
      "Bash(bash -c *)",
      "Bash(sh *)",
      "Bash(source *)",
      "Bash(env *)",
      "Bash(printenv *)",
      "Bash(curl -k *)",
      "Bash(curl -o *)",
      "Bash(curl -fsSL *)",
      "Bash(wget *)",
      "Bash(nc *)",
      "Bash(gh auth *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo archive *)",
      "Bash(gh release delete *)",
      "Bash(gh issue delete *)",
      "Read(~/.aws/credentials)",
      "Read(~/.ssh/id_*)",
      "Read(**/.ssh/id_*)",
      "Read(**/.env*)",
      "Read(**/*credential*)",
      "Read(**/.claude.json)",
      "Read(**/*mcp_settings.json)",
      "Read(**/goose/config.yaml)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(*_key)",
      "Read(*_token)",
      "Read(*.p12)",
      "Read(*.cert)"
    ]
  },
  "recommended": {
    "allow": [
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(git shortlog:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git describe:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-tree:*)",
      "Bash(git cat-file:*)",
      "Bash(git merge-base:*)",
      "Bash(git blame:*)",
      "Bash(git worktree list:*)",
      "Bash(git branch)",
      "Bash(git branch -a)",
      "Bash(git branch --show-current)",
      "Bash(git stash list:*)",
      "Read(~/.claude/**)"
    ]
  }
}
