{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/claude-pane-state.sh idle"
          },
          {
            "type": "command",
            "command": "~/.claude/claudedog/hooks/session-index.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/workflow-session-start.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/claude-pane-state.sh running"
          },
          {
            "type": "command",
            "command": "test -n \"$SSH_CONNECTION\" && printf '[SSH環境] ホスト: %s, 接続元: %s' \"$(hostname)\" \"$(echo $SSH_CONNECTION | cut -d' ' -f1)\""
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/workflow-skill-detect.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/claude-notify.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/claude-pane-state.sh permission"
          },
          {
            "type": "command",
            "command": "~/.claude/claudedog/hooks/permission-log.sh"
          }
        ]
      },
      {
        "matcher": "elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/claude-notify.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/claude-pane-state.sh ask"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/check-uncommitted-on-feature.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/claude-pane-state.sh idle"
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/workflow-session-log.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/claude-pane-state.sh end"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/claudedog/hooks/pretooluse-track.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/redirect-to-tools.py",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/approve-safe-commands.py",
            "timeout": 5000
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/approve-safe-file-ops.py",
            "timeout": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/claude-pane-state.sh running post"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/workflow-window-register.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // \"\"' | { read -r f; case \"$f\" in */tmux-sidebar/*.go) make -C /Users/sho-lab/ghq/github.com/ishii1648/tmux-sidebar install 2>/dev/null || true;; esac; }"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // \"\"' | { read -r f; case \"$f\" in */configs/tmux/tmux.conf) tmux source-file ~/.tmux.conf 2>/dev/null || true;; esac; }"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.js"
  },
  "language": "日本語",
  "effortLevel": "medium",
  "permissions": {
    "defaultMode": "auto"
  }
}
