{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/agent-pane-state.sh idle codex"
          },
          {
            "type": "command",
            "command": "agent-telemetry hook session-start --agent codex"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/agent-pane-state.sh idle codex"
          },
          {
            "type": "command",
            "command": "agent-telemetry hook stop --agent codex"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/agent-pane-state.sh running codex post"
          },
          {
            "type": "command",
            "command": "agent-telemetry hook post-tool-use --agent codex"
          }
        ]
      }
    ]
  }
}
